generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role?     @default(DONOR)
  authProvider  String?   @default("credentials")
  phone         String?
  address       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  donations     Donation[]
  ngoProfile    NGOProfile?
}

model NGOProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  address       String
  latitude      Float
  longitude     Float
  capacity      Int       @default(50)
  foodTypes     String[]  @default([])
  operatingHours String?
  contactPerson String?
  contactPhone  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matches       DonationMatch[]
}

model Donation {
  id              String        @id @default(cuid())
  donorId         String
  donor           User          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  title           String
  type            String
  foodType        String
  quantity        Int
  expiryDate      DateTime
  pickupStart     DateTime?
  pickupEnd       DateTime?
  latitude        Float
  longitude       Float
  address         String
  status          DonationStatus @default(PENDING)
  description     String?
  images          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  matches         DonationMatch[]
}

model DonationMatch {
  id            String        @id @default(cuid())
  donationId    String        @unique
  donation      Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngoId         String
  ngo           NGOProfile    @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  score         Float
  status        MatchStatus   @default(PENDING)
  matchedAt     DateTime      @default(now())
  acceptedAt    DateTime?
  completedAt   DateTime?
}

enum Role {
  DONOR
  NGO
  ADMIN
}

enum DonationStatus {
  PENDING
  MATCHED
  IN_TRANSIT
  COMPLETED
  EXPIRED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}